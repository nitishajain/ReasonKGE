    </ObjectProperty>
    


    <!-- http://semantics.crl.ibm.com/univ-bench-dl.owl#hasAlumnus -->

    <ObjectProperty rdf:about="http://semantics.crl.ibm.com/univ-bench-dl.owl#hasAlumnus">
        <inverseOf rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#hasDegreeFrom"/>
        <rdfs:domain rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#University"/>
        <rdfs:range rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#Person"/>
    </ObjectProperty>
    


    <!-- http://semantics.crl.ibm.com/univ-bench-dl.owl#hasDegreeFrom -->

