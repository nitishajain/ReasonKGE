        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#Person"/>
        <rdfs:range rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#Person"/>
