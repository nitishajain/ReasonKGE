    <!-- http://semantics.crl.ibm.com/univ-bench-dl.owl#AcademicSubject -->

    <Class rdf:about="http://semantics.crl.ibm.com/univ-bench-dl.owl#AcademicSubject">
        <disjointWith rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#Insterest"/>
        <disjointWith rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#Organization"/>
        <disjointWith rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#Person"/>
        <disjointWith rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#Publication"/>
        <disjointWith rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#Schedule"/>
        <disjointWith rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#Work"/>
    </Class>
    


    <!-- http://semantics.crl.ibm.com/univ-bench-dl.owl#Article -->

    <Class rdf:about="http://semantics.crl.ibm.com/univ-bench-dl.owl#Article">
        <rdfs:subClassOf rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#Publication"/>
    </Class>
    


    <!-- http://semantics.crl.ibm.com/univ-bench-dl.owl#AssistantProfessor -->

    <Class rdf:about="http://semantics.crl.ibm.com/univ-bench-dl.owl#AssistantProfessor">
        <rdfs:subClassOf rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#Professor"/>
    </Class>
    


    <!-- http://semantics.crl.ibm.com/univ-bench-dl.owl#AssociateProfessor -->

    <Class rdf:about="http://semantics.crl.ibm.com/univ-bench-dl.owl#AssociateProfessor">
        <rdfs:subClassOf rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#Professor"/>
    </Class>
    


    <!-- http://semantics.crl.ibm.com/univ-bench-dl.owl#BaseballFan -->

    <Class rdf:about="http://semantics.crl.ibm.com/univ-bench-dl.owl#BaseballFan">
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://semantics.crl.ibm.com/univ-bench-dl.owl#Person"/>
                    <Restriction>
                        <onProperty rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#isCrazyAbout"/>
                        <hasValue rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#Baseball"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
    </Class>
    


    <!-- http://semantics.crl.ibm.com/univ-bench-dl.owl#BaseballLover -->

    <Class rdf:about="http://semantics.crl.ibm.com/univ-bench-dl.owl#BaseballLover">
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://semantics.crl.ibm.com/univ-bench-dl.owl#Person"/>
                    <Restriction>
                        <onProperty rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#like"/>
                        <hasValue rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#Baseball"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
    </Class>
    


    <!-- http://semantics.crl.ibm.com/univ-bench-dl.owl#BasketBallFan -->

    <Class rdf:about="http://semantics.crl.ibm.com/univ-bench-dl.owl#BasketBallFan">
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
