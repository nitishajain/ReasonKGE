                    <Restriction>
                        <onProperty rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#isCrazyAbout"/>
                        <hasValue rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#BasketBall"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
    </Class>
    


    <!-- http://semantics.crl.ibm.com/univ-bench-dl.owl#BasketBallLover -->

    <Class rdf:about="http://semantics.crl.ibm.com/univ-bench-dl.owl#BasketBallLover">
        <rdfs:subClassOf>
