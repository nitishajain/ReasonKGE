    <!-- http://semantics.crl.ibm.com/univ-bench-dl.owl#Chair -->

    <Class rdf:about="http://semantics.crl.ibm.com/univ-bench-dl.owl#Chair">
        <rdfs:subClassOf rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#Professor"/>
        <rdfs:subClassOf>
            <Class>
                <intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://semantics.crl.ibm.com/univ-bench-dl.owl#Person"/>
                    <Restriction>
                        <onProperty rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#isHeadOf"/>
                        <someValuesFrom rdf:resource="http://semantics.crl.ibm.com/univ-bench-dl.owl#Department"/>
                    </Restriction>
                </intersectionOf>
            </Class>
        </rdfs:subClassOf>
    </Class>
    


