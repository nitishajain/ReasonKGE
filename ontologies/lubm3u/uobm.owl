    <!-- http://semantics.crl.ibm.com/univ-bench-dl.owl#isMemberOf -->

    <ObjectProperty rdf:about="http://semantics.crl.ibm.com/univ-bench-dl.owl#isMemberOf"/>
    


    <!-- http://semantics.crl.ibm.com/univ-bench-dl.owl#isStudentOf -->

    <ObjectProperty rdf:about="http://semantics.crl.ibm.com/univ-bench-dl.owl#isStudentOf">
